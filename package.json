{
  "name": "privacyllm-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "tauri": "tauri",
    "desktop:dev": "node scripts/setup_engine.mjs && tauri dev",
    "desktop:build": "node scripts/setup_engine.mjs && node scripts/prepare_desktop.mjs && tauri build --bundles app,dmg",
    "test": "vitest run",
    "engine:setup": "node scripts/setup_engine.mjs",
    "format": "prettier --plugin=prettier-plugin-svelte --write frontend/src frontend/index.html vite.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
